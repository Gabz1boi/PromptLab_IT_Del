# SQLite lokal. Untuk satu server acara dengan 60 peserta, gunakan satu instance Node.js
# dan volume penyimpanan persisten. Jangan gunakan filesystem sementara serverless.
DATABASE_URL="file:./dev.db"

# Ganti dengan kata sandi admin yang kuat sebelum deployment.
ADMIN_PASSWORD="ganti-dengan-kata-sandi-admin-yang-kuat"
ADMIN_SECRET="ganti-dengan-random-secret-minimal-32-karakter"

# Opsional: alamat dasar aplikasi untuk skrip uji beban.
APP_URL="http://localhost:3000"
